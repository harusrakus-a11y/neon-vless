#!/bin/bash

CYAN='\033[0;36m'
PURPLE='\033[0;35m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
WHITE='\033[1;37m'
NC='\033[0m' 

XRAY_CONFIG="/usr/local/etc/xray/config.json"
XRAY_LOG="/var/log/xray/access.log"
LICENSE_FILE="/usr/local/etc/xray/license.txt"
HOST_FILE="/usr/local/etc/xray/fixed_host.txt"

if [ -f "$HOST_FILE" ]; then
    FIXED_HOST=$(cat "$HOST_FILE")
else
    FIXED_HOST="harus.uhuk.fun"
    echo "$FIXED_HOST" > "$HOST_FILE"
fi

B1="https://raw.github"
B2="usercontent.com"
USER_GH="harusrakus-a11y"
REPO_GH="neon-vless"
FILE_GH="main/akses.txt"

TIME_STAMP=$(date +%s)
URL_AKSES="${B1}${B2}/${USER_GH}/${REPO_GH}/${FILE_GH}?t=${TIME_STAMP}"

check_license() {
    local valid_keys=$(curl -sL -H "Cache-Control: no-cache" "$URL_AKSES")
    if [[ -z "$valid_keys" || "$valid_keys" == *"404"* ]]; then exit 1; fi

    verify_process() {
        local input_key="$1"
        local match_line=$(echo "$valid_keys" | grep -w "^$input_key")
        if [[ ! -z "$match_line" ]]; then
            local exp_date=$(echo "$match_line" | cut -d'|' -f2)
            local current_epoch=$(date +%s)
            local exp_epoch=$(date -d "$exp_date" +%s 2>/dev/null)
            if [[ -z "$exp_epoch" ]]; then return 0; fi
            if [ "$current_epoch" -lt "$exp_epoch" ]; then
                export USER_EXP_DATE="$exp_date"
                return 0
            else
                exit 1
            fi
        fi
        return 1
    }

    if [ -f "$LICENSE_FILE" ]; then
        CURRENT_KEY=$(cat "$LICENSE_FILE")
        if verify_process "$CURRENT_KEY"; then return 0; fi
    fi

    clear
    read -p " Masukkan Kunci Akses / Nama User: " user_key
    if verify_process "$user_key"; then
        echo "$user_key" > "$LICENSE_FILE"
        return 0
    else
        exit 1
    fi
}

show_header() {
    clear
    echo -e "${CYAN}🚀===================================================🚀${NC}"
    echo -e "${PURPLE}       NEON TUNNEL v2.0 - PREMIUM MANAGER SCRIPT     ${NC}"
    echo -e "${CYAN}=====================================================:${NC}"
    echo -e " 👤 Active User : ${WHITE}$(cat $LICENSE_FILE 2>/dev/null)${NC} (Tamat: ${YELLOW}${USER_EXP_DATE:-Selamanya}${NC})"
    echo -e " 📡 Fixed Host  : ${GREEN}$FIXED_HOST${NC}"
    if systemctl is-active --quiet xray; then
        echo -e " ⚡ Status Xray  : ${GREEN}AKTIF (RUNNING)${NC}"
    else
        echo -e " ⚡ Status Xray  : ${RED}MATI (STOPPED)${NC}"
    fi
    echo -e "${CYAN}-----------------------------------------------------${NC}"
}

create_vless() {
    show_header
    read -p " Masukkan Nama Pengguna VPN Baru: " username
    if [[ -z "$username" ]]; then return; fi
    
    show_header
    echo -e "  ${GREEN}1.${NC} DIGI      (IP: 104.18.20.212)"
    echo -e "  ${GREEN}2.${NC} YES       (IP: 104.17.148.22)"
    echo -e "  ${GREEN}3.${NC} MAXIS     (IP: 172.66.43.86)"
    echo -e "  ${GREEN}4.${NC} UMOBILE   (IP: 172.66.40.170)"
    echo -e "  ${GREEN}5.${NC} CUSTOM IP ANYCAST"
    echo -e "${CYAN}-----------------------------------------------------${NC}"
    read -p " Pilih Target Telco Anda [1-5]: " telco_choice
    
    case $telco_choice in
        1) TELCO_NAME="DIGI"; TELCO_IP="104.18.20.212" ;;
        2) TELCO_NAME="YES"; TELCO_IP="104.17.148.22" ;;
        3) TELCO_NAME="MAXIS FREEZE"; TELCO_IP="172.66.43.86" ;;
        4) TELCO_NAME="UMOBILE"; TELCO_IP="172.66.40.170" ;;
        5) echo ""; read -p " Masukkan IP Custom: " TELCO_IP; TELCO_NAME="CUSTOM" ;;
    esac

    uuid=$(uuidgen)
    
    # Memasukkan pengguna ke tatasusunan clients secara seragam
    jq ".inbounds[0].settings.clients += [{\"id\": \"$uuid\", \"email\": \"$username\"}] |
        .inbounds[1].settings.clients += [{\"id\": \"$uuid\", \"email\": \"$username\"}]" $XRAY_CONFIG > /tmp/xray.json && mv /tmp/xray.json $XRAY_CONFIG
        
    systemctl restart xray
    
    show_header
    echo -e "${GREEN}✓ Akaun Berjaya Ditambah!${NC}"
    echo -e "${CYAN}-----------------------------------------------------${NC}"
    echo -e " 👤 Nama Pengguna : ${YELLOW}$username${NC}"
    echo -e " 📡 Telco Profil  : ${PURPLE}$TELCO_NAME${NC}"
    echo -e " 🌐 Anycast IP    : ${GREEN}$TELCO_IP${NC}"
    echo -e "${CYAN}-----------------------------------------------------${NC}"
    echo -e " ${CYAN}Port 80:${NC}"
    echo -e "${GREEN}vless://${uuid}@${TELCO_IP}:80?encryption=none&type=ws&host=${FIXED_HOST}&headerType=none&path=%2F#${username}${NC}\n"
    echo -e " ${CYAN}Port 8080:${NC}"
    echo -e "${GREEN}vless://${uuid}@${TELCO_IP}:8080?encryption=none&type=ws&host=${FIXED_HOST}&headerType=none&path=%2F#${username}${NC}"
    echo -e "${CYAN}-----------------------------------------------------${NC}"
    read -n 1 -s -r -p "Tekan mana-mana butang untuk kembali ke menu..."
}

check_login() {
    show_header
    if [ ! -f "$XRAY_LOG" ]; then echo -e "${RED}Ralat: Fail log Xray tidak ditemui.${NC}"; else
        tail -n 100 "$XRAY_LOG" | grep "accepted" | awk '{print $1" "$2" | "$7" | "$3}' | sort -u
    fi
    read -n 1 -s -r -p "Tekan mana-mana butang..."
}

change_host() {
    show_header
    read -p " Masukkan Domain/Fixed Host Baru: " new_host
    if [[ ! -z "$new_host" ]]; then echo "$new_host" > "$HOST_FILE"; FIXED_HOST="$new_host"; fi
}

check_license
while true; do
    show_header
    echo -e "  ${GREEN}1.${NC} Cipta Akaun VLESS Premium"
    echo -e "  ${GREEN}2.${NC} Semak Pengguna Log Masuk / Login (Live)"
    echo -e "  ${GREEN}3.${NC} Tukar Fixed Host / Domain Tunnel"
    echo -e "  ${RED}4.${NC} Keluar"
    read -p " Pilih Pilihan Anda [1-4]: " pilihan
    case $pilihan in
        1) create_vless ;;
        2) check_login ;;
        3) change_host ;;
        4) clear; exit 0 ;;
    esac
done
