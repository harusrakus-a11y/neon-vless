#!/bin/bash

# ===================================================
# TEMA WARNA (RAKUS SCRIPT PREMIUM STYLE)
# ===================================================
CYAN='\033[0;36m'
PURPLE='\033[0;35m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
WHITE='\033[1;37m'
NC='\033[0m'

XRAY_CONFIG="/usr/local/etc/xray/config.json"
LICENSE_FILE="/usr/local/etc/xray/license.txt"
HOST_FILE="/usr/local/etc/xray/fixed_host.txt"

# Penjenamaan Kustom Baru Anda
VERSION="Rakus Script v1.0"
UPTIME=$(uptime -p | sed 's/up //')
TOTAL_USERS=$(jq '.inbounds[0].settings.clients | length' $XRAY_CONFIG 2>/dev/null)

if [ -f "$HOST_FILE" ]; then FIXED_HOST=$(cat "$HOST_FILE"); else FIXED_HOST="harus.uhuk.fun"; echo "$FIXED_HOST" > "$HOST_FILE"; fi

# Pautan Pintasan GitHub Pusat (Anti-Tapis)
B1="https://raw.github" && B2="usercontent.com"
USER_GH="harusrakus-a11y" && REPO_GH="neon-vless" && FILE_GH="main/akses.txt"
URL_AKSES="${B1}${B2}/${USER_GH}/${REPO_GH}/${FILE_GH}?t=$(date +%s)"

check_license() {
    local valid_keys=$(curl -sL -H "Cache-Control: no-cache" "$URL_AKSES")
    if [[ -z "$valid_keys" || "$valid_keys" == *"404"* ]]; then exit 1; fi
    verify_process() {
        local input_key="$1"
        local match_line=$(echo "$valid_keys" | grep -w "^$input_key")
        if [[ ! -z "$match_line" ]]; then
            local exp_date=$(echo "$match_line" | cut -d'|' -f2)
            if [ "$(date +%s)" -lt "$(date -d "$exp_date" +%s 2>/dev/null)" ]; then
                export USER_EXP_DATE="$exp_date"
                return 0
            fi
        fi
        return 1
    }
    if [ -f "$LICENSE_FILE" ] && verify_process "$(cat $LICENSE_FILE)"; then return 0; fi
    clear
    echo -e "${CYAN}=====================================================${NC}"
    echo -e "${PURPLE}           RAKUS SCRIPT - LICENSE VERIFICATION       ${NC}"
    echo -e "${CYAN}=====================================================${NC}"
    read -p " Masukkan Kunci Akses: " user_key
    if verify_process "$user_key"; then echo "$user_key" > "$LICENSE_FILE"; else echo -e "${RED}Lesen Tidak Sah!${NC}"; exit 1; fi
}

show_dashboard() {
    clear
    echo -e "${CYAN}┌───────────────────────────────────────────────────┐${NC}"
    echo -e "${CYAN}│${PURPLE}              PREMIUM AUTOSCRIPT ${VERSION}          ${CYAN}│${NC}"
    echo -e "${CYAN}└───────────────────────────────────────────────────┘${NC}"
    echo -e " ${PURPLE}• RAKUS SCRIPT SYSTEM INFO •${NC}"
    echo -e " Version          : ${GREEN}${VERSION}${NC}"
    echo -e " Server Uptime    : ${YELLOW}${UPTIME}${NC}"
    echo -e " Target Fixed SNI : ${WHITE}${FIXED_HOST}${NC}"
    echo -e " Total Users      : ${GREEN}${TOTAL_USERS:-0} Users${NC}"
    echo -e "${CYAN}─────────────────────────────────────────────────────${NC}"
    echo -e " ${PURPLE}• PORT & PROTOCOL DETAIL •${NC}"
    echo -e "  ${GREEN}1.${NC} SSH / Dropbear       : Port 22, 109"
    echo -e "  ${GREEN}2.${NC} VLESS WebSocket      : Port 80, 8080"
    echo -e "  ${GREEN}3.${NC} VMESS WebSocket      : Port 8080"
    echo -e "  ${GREEN}4.${NC} TROJAN WebSocket     : Port 8880"
    echo -e "  ${GREEN}5.${NC} Semak Pengguna Aktif : (Live Checker)"
    echo -e "  ${GREEN}6.${NC} Tukar Fixed Host     : (Change SNI)"
    echo -e "  ${RED}7.${NC} Keluar"
    echo -e "${CYAN}─────────────────────────────────────────────────────${NC}"
}

create_account() {
    local proto="$1"
    local port="$2"
    show_dashboard
    echo -e "${YELLOW}[ JANA AKAUN ${proto^^} PREMIUM ]${NC}\n"
    read -p " Masukkan Nama Pengguna Baru: " username
    if [[ -z "$username" ]]; then return; fi
    
    echo -e "\nPilih IP Anycast Telco:\n 1. DIGI (104.18.20.212)\n 2. YES (104.17.148.22)\n 3. MAXIS (172.66.43.86)\n 4. UMOBILE (172.66.40.170)"
    read -p " Pilihan anda [1-4]: " t_choice
    case $t_choice in
        1) T_IP="104.18.20.212" ;;
        2) T_IP="104.17.148.22" ;;
        3) T_IP="172.66.43.86" ;;
        4) T_IP="172.66.40.170" ;;
        *) T_IP="104.18.20.212" ;;
    esac

    uuid=$(uuidgen)
    
    # Injeksi akaun ke fail config JSON menggunakan jq (Inbound 0 & 1)
    jq ".inbounds[0].settings.clients += [{\"id\": \"$uuid\", \"email\": \"$username\"}] |
        .inbounds[1].settings.clients += [{\"id\": \"$uuid\", \"email\": \"$username\"}]" $XRAY_CONFIG > /tmp/x.json && mv /tmp/x.json $XRAY_CONFIG
    systemctl restart xray 2>/dev/null
    
    clear
    echo -e "${GREEN}✓ Akaun ${proto^^} Berjaya Ditambah!${NC}"
    echo -e "${CYAN}─────────────────────────────────────────────────────${NC}"
    echo -e " 👤 Nama Pengguna : ${YELLOW}$username${NC}"
    echo -e " 📡 Profil        : ${PURPLE}${proto^^} WS${NC}"
    echo -e " 🌐 Anycast IP    : ${GREEN}$T_IP${NC}"
    echo -e "${CYAN}─────────────────────────────────────────────────────${NC}"
    echo -e "${GREEN}vless://${uuid}@${T_IP}:${port}?encryption=none&type=ws&host=${FIXED_HOST}&path=%2F#${username}${NC}"
    echo -e "${CYAN}─────────────────────────────────────────────────────${NC}"
    read -n 1 -s -r -p "Tekan mana-mana butang..."
}

check_login() {
    show_dashboard
    echo -e "${YELLOW}[ SEMAK PENGGUNA AKTIF ]${NC}\n"
    tail -n 30 /var/log/xray/access.log 2>/dev/null | grep "accepted" | awk '{print " 🟢 User: " $7 " -> IP: " $3}' | sort -u
    read -n 1 -s -r -p "Tekan mana-mana butang..."
}

change_host() {
    show_dashboard
    read -p " Masukkan Fixed Host Baru: " new_host
    if [[ ! -z "$new_host" ]]; then echo "$new_host" > "$HOST_FILE"; FIXED_HOST="$new_host"; fi
}

check_license
while true; do
    show_dashboard
    read -p " Sila Pilih Menu Anda [1-7]: " pilihan
    case $pilihan in
        1) create_account "ssh" "22" ;;
        2) create_account "vless" "80" ;;
        3) create_account "vmess" "8080" ;;
        4) create_account "trojan" "8880" ;;
        5) check_login ;;
        6) change_host ;;
        7) clear; exit 0 ;;
    esac
done
