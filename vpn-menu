#!/bin/bash

# ===================================================
# TEMA WARNA (RAKUS SCRIPT PREMIUM STYLE)
# ===================================================
CYAN='\033[0;36m'
PURPLE='\033[0;35m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
WHITE='\033[1;37m'
NC='\033[0m'

XRAY_CONFIG="/usr/local/etc/xray/config.json"
LICENSE_FILE="/usr/local/etc/xray/license.txt"
HOST_FILE="/usr/local/etc/xray/fixed_host.txt"

VERSION="Rakus Script v1.0"
UPTIME=$(uptime -p | sed 's/up //')
TOTAL_USERS=$(jq '.inbounds[0].settings.clients | length' $XRAY_CONFIG 2>/dev/null)

if [ -f "$HOST_FILE" ]; then FIXED_HOST=$(cat "$HOST_FILE"); else FIXED_HOST="harus.uhuk.fun"; echo "$FIXED_HOST" > "$HOST_FILE"; fi

B1="https://raw.github" && B2="usercontent.com"
USER_GH="harusrakus-a11y" && REPO_GH="neon-vless" && FILE_GH="main/akses.txt"
URL_AKSES="${B1}${B2}/${USER_GH}/${REPO_GH}/${FILE_GH}?t=$(date +%s)"

check_license() {
    local valid_keys=$(curl -sL -H "Cache-Control: no-cache" "$URL_AKSES")
    if [[ -z "$valid_keys" || "$valid_keys" == *"404"* ]]; then exit 1; fi
    verify_process() {
        local input_key="$1"
        local match_line=$(echo "$valid_keys" | grep -w "^$input_key")
        if [[ ! -z "$match_line" ]]; then
            if [[ "$match_line" == *"|"* ]]; then
                local exp_date=$(echo "$match_line" | cut -d'|' -f2)
                if [ "$(date +%s)" -lt "$(date -d "$exp_date" +%s 2>/dev/null)" ]; then
                    export USER_EXP_DATE="$exp_date"
                    return 0
                else
                    exit 1
                fi
            fi
            export USER_EXP_DATE="Selamanya"
            return 0
        fi
        return 1
    }
    if [ -f "$LICENSE_FILE" ] && verify_process "$(cat $LICENSE_FILE)"; then return 0; fi
    clear
    read -p " Masukkan Kunci Akses: " user_key
    if verify_process "$user_key"; then echo "$user_key" > "$LICENSE_FILE"; else exit 1; fi
}

show_dashboard() {
    clear
    echo -e "${CYAN}┌───────────────────────────────────────────────────┐${NC}"
    echo -e "${CYAN}│${PURPLE}              PREMIUM AUTOSCRIPT ${VERSION}          ${CYAN}│${NC}"
    echo -e "${CYAN}└───────────────────────────────────────────────────┘${NC}"
    echo -e " ${PURPLE}• RAKUS SCRIPT SYSTEM INFO •${NC}"
    echo -e " Version          : ${GREEN}${VERSION}${NC}"
    echo -e " Server Uptime    : ${YELLOW}${UPTIME}${NC}"
    echo -e " Target Fixed SNI : ${WHITE}${FIXED_HOST}${NC}"
    echo -e " Total Users      : ${GREEN}${TOTAL_USERS:-0} Users${NC}"
    echo -e "${CYAN}─────────────────────────────────────────────────────${NC}"
    echo -e " ${PURPLE}• MAIN MENU PROTOCOL & MANAGER •${NC}"
    echo -e "  ${GREEN}[01]${NC} Create Account VLESS (Port 80/8080)"
    echo -e "  ${GREEN}[02]${NC} Check Active User Login (Live)"
    echo -e "  ${GREEN}[03]${NC} ROUTING MANAGER (Block/Domain)"
    echo -e "  ${GREEN}[04]${NC} MENU BOT & BACKUP MANAGER"
    echo -e "  ${GREEN}[05]${NC} DNS MANAGER (Cloudflare/Google)"
    echo -e "  ${GREEN}[06]${NC} Change Target Fixed SNI / Domain"
    echo -e "  ${RED}[07]${NC} Exit Script"
    echo -e "${CYAN}─────────────────────────────────────────────────────${NC}"
}

# ===================================================
# SUB-MENU 1: ROUTING MANAGER
# ===================================================
block_manager() {
    clear
    echo -e "${RED}[ BLOCK MANAGER ]${NC}\n"
    echo -e " 1. Sekat Lucah (PornBlock)\n 2. Sekat Torrent\n 3. Sekat Iklan\n 4. Kembali"
    read -p " Pilih [1-4]: " bc
    case $bc in
        1) jq ".outbounds += [{\"protocol\": \"blackhole\", \"tag\": \"block_p\"}] | .routing.rules += [{\"type\": \"field\", \"outboundTag\": \"block_p\", \"domain\": [\"geosite:category-porn\"]}]" $XRAY_CONFIG > /tmp/x.json && mv /tmp/x.json $XRAY_CONFIG && systemctl restart xray && echo "✓ Diskat!"; sleep 2 ;;
        2) jq ".outbounds += [{\"protocol\": \"blackhole\", \"tag\": \"block_t\"}] | .routing.rules += [{\"type\": \"field\", \"outboundTag\": \"block_t\", \"protocol\": [\"bittorrent\"]}]" $XRAY_CONFIG > /tmp/x.json && mv /tmp/x.json $XRAY_CONFIG && systemctl restart xray && echo "✓ Torrent Disekat!"; sleep 2 ;;
        3) jq ".outbounds += [{\"protocol\": \"blackhole\", \"tag\": \"block_a\"}] | .routing.rules += [{\"type\": \"field\", \"outboundTag\": \"block_a\", \"domain\": [\"geosite:category-ads-all\"]}]" $XRAY_CONFIG > /tmp/x.json && mv /tmp/x.json $XRAY_CONFIG && systemctl restart xray && echo "✓ Iklan Disekat!"; sleep 2 ;;
    esac
}

domain_manager() {
    clear
    echo -e "${YELLOW}[ DOMAIN MANAGER ]${NC}\n"
    read -p " Masukkan domain nak sekat (cth: tiktok.com): " bad_dom
    [ -z "$bad_dom" ] && return
    jq --arg dom "$bad_dom" ".outbounds += [{\"protocol\": \"blackhole\", \"tag\": \"block_c\"}] | .routing.rules += [{\"type\": \"field\", \"outboundTag\": \"block_c\", \"domain\": [\$dom]}]" $XRAY_CONFIG > /tmp/x.json && mv /tmp/x.json $XRAY_CONFIG && systemctl restart xray
    echo "✓ Domain $bad_dom disekat!"; sleep 2
}

