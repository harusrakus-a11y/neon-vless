#!/bin/bash

CYAN='\033[0;36m'
PURPLE='\033[0;35m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' 

XRAY_CONFIG="/usr/local/etc/xray/config.json"
FIXED_HOST="harus.uhuk.fun"
LICENSE_FILE="/usr/local/etc/xray/license.txt"

# Membina URL GitHub secara selamat (Pintasan 100% Anti-Potong Pautan)
B1="https://raw.github"
B2="usercontent.com"
USER_GH="harusrakus-a11y"
REPO_GH="neon-vless"
FILE_GH="main/akses.txt"

TIME_STAMP=$(date +%s)
URL_AKSES="${B1}${B2}/${USER_GH}/${REPO_GH}/${FILE_GH}?t=${TIME_STAMP}"

check_license() {
    # Muat turun senarai akses dengan memintas cache
    local valid_keys=$(curl -sL -H "Cache-Control: no-cache" "$URL_AKSES")
    
    if [[ -z "$valid_keys" || "$valid_keys" == *"404"* ]]; then
        echo -e "${RED}Ralat: Pangkalan data pusat kosong atau tidak ditemui di GitHub.${NC}"
        echo -e "${YELLOW}Pastikan fail akses.txt wujud di dalam repository neon-vless anda.${NC}"
        exit 1
    fi

    if [ -f "$LICENSE_FILE" ]; then
        CURRENT_KEY=$(cat "$LICENSE_FILE")
        if echo "$valid_keys" | grep -qxF "$CURRENT_KEY"; then
            return 0
        fi
    fi

    clear
    echo -e "${CYAN}🚀=================================================🚀${NC}"
    echo -e "${PURPLE}           NEON TUNNEL - REMOTE AUTHENTICATION       ${NC}"
    echo -e "${CYAN}===================================================:${NC}"
    echo -e "${YELLOW}Skrip ini dilindungi. Sila masukkan Kunci Akses anda.${NC}"
    echo -e "${CYAN}---------------------------------------------------${NC}"
    read -p " Masukkan Kunci Akses / Nama User: " user_key

    if echo "$valid_keys" | grep -qxF "$user_key"; then
        echo "$user_key" > "$LICENSE_FILE"
        echo -e "\n${GREEN}✓ Akses Dibenarkan! Selamat datang.${NC}"
        sleep 2
        return 0
    else
        echo -e "\n${RED}✗ Ralat: Nama User / Kunci Akses Tidak Sah!${NC}"
        echo -e "${YELLOW}Sila hubungi pemilik skrip untuk pendaftaran akaun.${NC}"
        sleep 3
        exit 1
    fi
}

show_header() {
    clear
    echo -e "${CYAN}🚀=================================================🚀${NC}"
    echo -e "${PURPLE}     NEON TUNNEL - SMART ANYCAST TELCO BYPASS      ${NC}"
    echo -e "${CYAN}===================================================:${NC}"
    echo -e " Fixed Host (SNI) : ${YELLOW}$FIXED_HOST${NC}"
    if systemctl is-active --quiet xray; then
        echo -e " Status Xray      : ${GREEN}AKTIF (RUNNING)${NC}"
    else
        echo -e " Status Xray      : ${RED}MATI (STOPPED)${NC}"
    fi
    echo -e "${CYAN}---------------------------------------------------${NC}"
}

create_vless() {
    show_header
    echo -e "${YELLOW}[ TAMBAH PENGGUNA VLESS MULTI-TELCO ]${NC}\n"
    read -p " Masukkan Nama Pengguna: " username
    if [[ -z "$username" ]]; then 
        echo -e "${RED}Nama pengguna tidak boleh kosong!${NC}"
        sleep 2
        return
    fi
    
    show_header
    echo -e "${YELLOW}[ SILA PILIH TARGET TELCO ANDA ]${NC}\n"
    echo -e "  ${GREEN}1.${NC} DIGI      (IP: 104.18.20.212)"
    echo -e "  ${GREEN}2.${NC} YES       (IP: 104.17.148.22)"
    echo -e "  ${GREEN}3.${NC} MAXIS     (IP: 172.66.43.86)"
    echo -e "  ${GREEN}4.${NC} UMOBILE   (IP: 172.66.40.170)"
    echo -e "  ${GREEN}5.${NC} CUSTOM IP"
    echo -e "${CYAN}---------------------------------------------------${NC}"
    read -p " Pilih Target Telco Anda [1-5]: " telco_choice
    
    case $telco_choice in
        1) TELCO_NAME="DIGI"; TELCO_IP="104.18.20.212" ;;
        2) TELCO_NAME="YES"; TELCO_IP="104.17.148.22" ;;
        3) TELCO_NAME="MAXIS FREEZE"; TELCO_IP="172.66.43.86" ;;
        4) TELCO_NAME="UMOBILE"; TELCO_IP="172.66.40.170" ;;
        5) 
            echo ""
            read -p " Masukkan IP Custom: " TELCO_IP
            TELCO_NAME="CUSTOM"
            if [[ -z "$TELCO_IP" ]]; then TELCO_IP="104.18.20.212"; fi
            ;;
        *) TELCO_NAME="DIGI"; TELCO_IP="104.18.20.212" ;;
    esac

    uuid=$(uuidgen)
    
    jq ".inbounds.settings.clients += [{\"id\": \"$uuid\", \"email\": \"$username\"}] |
        .inbounds.settings.clients += [{\"id\": \"$uuid\", \"email\": \"$username\"}]" $XRAY_CONFIG > /tmp/xray.json && mv /tmp/xray.json $XRAY_CONFIG
        
    systemctl restart xray
    
    show_header
    echo -e "${GREEN}✓ Akaun Berjaya Ditambah!${NC}"
    echo -e "${CYAN}---------------------------------------------------${NC}"
    echo -e " 👤 Nama Pengguna : ${YELLOW}$username${NC}"
    echo -e " 📡 Telco Profil  : ${PURPLE}$TELCO_NAME${NC}"
    echo -e " 🌐 Anycast IP    : ${GREEN}$TELCO_IP${NC}"
    echo -e "${CYAN}---------------------------------------------------${NC}"
    echo -e "${YELLOW}Salin konfigurasi mengikut port yang anda inginkan:${NC}\n"
    echo -e " ${CYAN}Port 80:${NC}"
    echo -e "${GREEN}vless://${uuid}@${TELCO_IP}:80?encryption=none&type=ws&host=${FIXED_HOST}&headerType=none&path=%2F#${username}${NC}\n"
    echo -e " ${CYAN}Port 8080:${NC}"
    echo -e "${GREEN}vless://${uuid}@${TELCO_IP}:8080?encryption=none&type=ws&host=${FIXED_HOST}&headerType=none&path=%2F#${username}${NC}"
    echo -e "${CYAN}---------------------------------------------------${NC}"
    read -n 1 -s -r -p "Tekan mana-mana butang untuk kembali ke menu..."
}

check_license

while true; do
    show_header
    echo -e "  ${GREEN}1.${NC} Cipta Akaun VLESS Premium (Pilih Telco IP)"
    echo -e "  ${RED}2.${NC} Keluar"
    echo -e "${CYAN}===================================================:${NC}"
    read -p " Pilih Pilihan Anda [1-2]: " pilihan
    case $pilihan in
        1) create_vless ;;
        2) clear; exit 0 ;;
    esac
done
