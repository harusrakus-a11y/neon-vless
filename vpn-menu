        echo -e "${CYAN}┌───────────────────────────────────────────────────┐${NC}"
        echo -e "${CYAN}│${PURPLE}                 ROUTING MANAGER                   ${CYAN}│${NC}"
        echo -e "${CYAN}└───────────────────────────────────────────────────┘${NC}"
        echo -e " Current Mode   : ${GREEN}Custom${NC}"
        echo -e " Active Rules   : ${YELLOW}0${NC}"
        echo -e " Pending Change : ${WHITE}0${NC}"
        echo -e "${CYAN}─────────────────────────────────────────────────────${NC}"
        echo -e "  ${GREEN}[01]${NC} Routing Mode"
        echo -e "  ${GREEN}[02]${NC} Direct Manager"
        echo -e "  ${GREEN}[03]${NC} Block Manager"
        echo -e "  ${GREEN}[04]${NC} Domain Manager"
        echo -e "  ${GREEN}[05]${NC} Outbound Manager"
        echo -e "  ${GREEN}[06]${NC} View Active Rules"
        echo -e "  ${GREEN}[07]${NC} Test Configuration"
        echo -e "  ${GREEN}[08]${NC} Apply Changes"
        echo -e "  ${GREEN}[09]${NC} Reset Routing To Default"
        echo -e "  ${RED}[10]${NC} Back to System VPS"
        echo -e "${CYAN}─────────────────────────────────────────────────────${NC}"
        read -p " Please select an option [01-10 or x]: " r_choice
        case $r_choice in
            10|x) break ;;
            *) echo -e "${GREEN}Fungsi simulasi aktif!${NC}"; sleep 1 ;;
        esac
    done
}

