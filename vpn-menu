# ===================================================
# SUB-MENU 3: DNS MANAGER
# ===================================================
dns_manager() {
    while true; do
        clear
        echo -e "${CYAN}┌───────────────────────────────────────────────────┐${NC}"
        echo -e "${CYAN}│${PURPLE}                    DNS MANAGER                    ${CYAN}│${NC}"
        echo -e "${CYAN}└───────────────────────────────────────────────────┘${NC}"
        echo -e " Current DNS     : ${GREEN}Cloudflare${NC}"
        echo -e " Primary DNS     : ${YELLOW}1.1.1.1${NC}"
        echo -e " Secondary DNS   : ${YELLOW}1.0.0.1${NC}"
        echo -e " DNS Resolution  : ${GREEN}OK${NC}"
        echo -e "${CYAN}─────────────────────────────────────────────────────${NC}"
        echo -e "  ${GREEN}[01]${NC} Cloudflare DNS"
        echo -e "  ${GREEN}[02]${NC} Google DNS"
        echo -e "  ${GREEN}[03]${NC} Quad9 DNS"
        echo -e "  ${GREEN}[04]${NC} AdGuard DNS"
        echo -e "  ${GREEN}[05]${NC} Custom DNS"
        echo -e "  ${GREEN}[06]${NC} DNS Benchmark"
        echo -e "  ${GREEN}[07]${NC} DNS Diagnostic"
        echo -e "  ${GREEN}[08]${NC} Restore System DNS"
        echo -e "  ${RED}[09]${NC} Back to System VPS"
        echo -e "${CYAN}─────────────────────────────────────────────────────${NC}"
        read -p " Select option: " d_choice
        case $d_choice in
            6) jq "del(.routing.rules) | del(.outbounds[] | select(.tag | tr \"[:upper:]\" \"[:lower:]\" | contains(\"block\")))" $XRAY_CONFIG > /tmp/x.json && mv /tmp/x.json $XRAY_CONFIG && systemctl restart xray && echo "✓ Reset Selesai!"; sleep 2 ;;
            10|x) break ;;
            *) echo -e "${GREEN}DNS dikemaskini (Simulasi)!${NC}"; sleep 1 ;;
        esac
    done
}

create_account() {
    show_dashboard
    echo -e "${YELLOW}[ JANA AKAUN VLESS MULTI-TELCO ]${NC}\n"
    read -p " Masukkan Nama Pengguna Baru: " username
    if [[ -z "$username" ]]; then return; fi
    
    echo -e "\nPilih IP Anycast Telco:\n 1. DIGI (104.18.20.212)\n 2. YES (104.17.148.22)\n 3. MAXIS (172.66.43.86)\n 4. UMOBILE (172.66.40.170)"
    read -p " Pilihan anda [1-4]: " t_choice
    case $t_choice in
        1) T_IP="104.18.20.212" ;;
        2) T_IP="104.17.148.22" ;;
        3) T_IP="172.66.43.86" ;;
        4) T_IP="172.66.40.170" ;;
        *) T_IP="104.18.20.212" ;;
    esac

    uuid=$(uuidgen)
    jq ".inbounds[0].settings.clients += [{\"id\": \"$uuid\", \"email\": \"$username\"}] |
        .inbounds[1].settings.clients += [{\"id\": \"$uuid\", \"email\": \"$username\"}]" $XRAY_CONFIG > /tmp/x.json && mv /tmp/x.json $XRAY_CONFIG
    systemctl restart xray 2>/dev/null
    
    clear
    echo -e "${GREEN}✓ Akaun Berjaya Ditambah!${NC}"
    echo -e "${CYAN}─────────────────────────────────────────────────────${NC}"
    echo -e " 👤 Nama Pengguna : ${YELLOW}$username${NC}"
    echo -e " 🌐 Anycast IP    : ${GREEN}$T_IP${NC}"
    echo -e "${CYAN}─────────────────────────────────────────────────────${NC}"
    echo -e " Port 80: ${GREEN}vless://${uuid}@${T_IP}:80?encryption=none&type=ws&host=${FIXED_HOST}&path=%2F#${username}${NC}\n"
    read -n 1 -s -r -p "Tekan mana-mana butang..."
}

check_login() {
    show_dashboard
    tail -n 30 /var/log/xray/access.log 2>/dev/null | grep "accepted" | awk '{print " 🟢 User: " $7 " -> IP: " $3}' | sort -u
    read -n 1 -s -r -p "Tekan mana-mana butang..."
}

change_host() {
    show_dashboard
    read -p " Masukkan Fixed Host Baru: " new_host
    if [[ ! -z "$new_host" ]]; then echo "$new_host" > "$HOST_FILE"; FIXED_HOST="$new_host"; fi
}

check_license
while true; do
    show_dashboard
    read -p " Sila Pilih Menu Anda [1-7]: " pilihan
    case $pilihan in
        1) create_account ;;
        2) check_login ;;
        3) routing_manager ;;
        4) backup_manager ;;
        5) dns_manager ;;
        6) change_host ;;
        7) clear; exit 0 ;;
    esac
done
